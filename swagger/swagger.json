{
  "openapi": "3.0.3",
  "info": {
    "title": "Saltmine Prototype API - V1 Baseline",
    "version": "1.0.0",
    "description": "Additive multi-tenant samples with seeded data."
  },
  "tags": [
    {
      "name": "Tenants"
    }
  ],
  "paths": {
    "/api/{tenantId}/users": {
      "get": {
        "tags": [
          "Tenants"
        ],
        "summary": "Get users",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "examples": {
                  "bankcorp": {
                    "value": {
                      "tenantId": "bankcorp",
                      "entity": "users",
                      "data": [
                        {
                          "id": 1,
                          "name": "Alice",
                          "role": "Relationship Manager"
                        },
                        {
                          "id": 2,
                          "name": "Raj",
                          "role": "Credit Analyst"
                        }
                      ]
                    }
                  },
                  "retailx": {
                    "value": {
                      "tenantId": "retailx",
                      "entity": "users",
                      "data": [
                        {
                          "id": 1,
                          "name": "Priya",
                          "role": "Store Manager"
                        }
                      ]
                    }
                  }
                }
              }
            }
          }
        },
        "parameters": [
          {
            "name": "tenantId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "enum": [
                "bankcorp",
                "retailx",
                "healthplus"
              ]
            }
          }
        ]
      },
      "post": {
        "tags": [
          "Tenants"
        ],
        "summary": "Create user (path tenant)",
        "responses": {
          "201": {
            "description": "Created"
          }
        },
        "parameters": [
          {
            "name": "tenantId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "enum": [
                "bankcorp",
                "retailx",
                "healthplus"
              ]
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "examples": {
                "bankcorp": {
                  "value": {
                    "name": "Nikhil",
                    "role": "Analyst"
                  }
                },
                "retailx": {
                  "value": {
                    "name": "Asha",
                    "role": "Associate"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/users": {
      "post": {
        "tags": [
          "Tenants"
        ],
        "summary": "Create user (header tenant)",
        "responses": {
          "201": {
            "description": "Created"
          }
        },
        "parameters": [
