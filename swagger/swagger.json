            "required": true,
            "schema": {
              "type": "string",
              "enum": [
                "bankcorp",
                "retailx",
                "healthplus"
              ]
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "examples": {
                "healthplus": {
                  "value": {
                    "name": "Leela",
                    "role": "Nurse"
                  }
                },
                "bankcorp": {
                  "value": {
                    "name": "Tom",
                    "role": "Auditor"
                  }
                }
              }
            }
          }
        }
      }
    },
