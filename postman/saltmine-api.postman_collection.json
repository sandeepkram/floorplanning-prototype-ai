{
  "info": {
    "name": "FloorDoc API — V5",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "POST /events — Create occupancy event",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "x-tenant-id", "value": "bankcorp" },
          { "key": "x-user-role", "value": "admin" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"tenant_id\": \"bankcorp\",\n  \"room_id\": \"conf_A\",\n  \"timestamp\": \"2025-01-01T10:00:00Z\",\n  \"people_count\": 3,\n  \"office_id\": \"blr_finops\"\n}"
        },
        "url": {
          "raw": "http://localhost:8080/events",
          "protocol": "http",
          "host": ["localhost"],
          "port": "8080",
          "path": ["events"]
        }
      }
    },
    {
      "name": "GET /events — List events for tenant",
      "request": {
        "method": "GET",
        "header": [
          { "key": "x-tenant-id", "value": "bankcorp" },
          { "key": "x-user-role", "value": "viewer" }
        ],
        "url": {
          "raw": "http://localhost:8080/events?tenant_id=bankcorp",
          "protocol": "http",
          "host": ["localhost"],
          "port": "8080",
          "path": ["events"],
          "query": [
            { "key": "tenant_id", "value": "bankcorp" }
          ]
        }
      }
    },
    {
      "name": "GET /utilization — Room utilization metrics",
      "request": {
        "method": "GET",
        "header": [
          { "key": "x-tenant-id", "value": "bankcorp" },
          { "key": "x-user-role", "value": "analyst" }
        ],
        "url": {
          "raw": "http://localhost:8080/utilization?tenant_id=bankcorp&room_id=conf_A",
          "protocol": "http",
          "host": ["localhost"],
          "port": "8080",
          "path": ["utilization"],
          "query": [
            { "key": "tenant_id", "value": "bankcorp" },
            { "key": "room_id", "value": "conf_A" }
          ]
        }
      }
    },
    {
      "name": "GET /recommend — Underutilized room recommendations",
      "request": {
        "method": "GET",
        "header": [
          { "key": "x-tenant-id", "value": "bankcorp" },
          { "key": "x-user-role", "value": "analyst" }
        ],
        "url": {
          "raw": "http://localhost:8080/recommend?tenant_id=bankcorp&office_id=blr_finops",
          "protocol": "http",
          "host": ["localhost"],
          "port": "8080",
          "path": ["recommend"],
          "query": [
            { "key": "tenant_id", "value": "bankcorp" },
            { "key": "office_id", "value": "blr_finops" }
          ]
        }
      }
    },
    {
      "name": "POST /query — Natural language query",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "x-user-role", "value": "analyst" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"q\": \"recommend rooms for blr_finops in bankcorp\"\n}"
        },
        "url": {
          "raw": "http://localhost:8080/query",
          "protocol": "http",
          "host": ["localhost"],
          "port": "8080",
          "path": ["query"]
        }
      }
    },
    {
      "name": "GET /health — Liveness probe",
      "request": {
        "method": "GET",
        "url": {
